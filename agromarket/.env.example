# ===== Entorno =====
NODE_ENV=development
PORT=3000
# URL pública sin barra final (en Render: https://tu-app.onrender.com; con dominio propio: https://tudominio.com.ar)
BASE_URL=http://localhost:3000
SITE_NAME=AgroMarket
# Clave para firmar sesiones. Generar con: openssl rand -hex 32   (obligatoria en producción)
SESSION_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# ===== Base de datos =====
# development/test usan SQLite en DATA_DIR (no requiere nada más).
# production: si DATABASE_URL empieza con postgres:// usa PostgreSQL (Neon, Supabase, Render, VPS);
#             si está vacía usa SQLite en DATA_DIR/prod.sqlite (VPS con disco persistente).
DATABASE_URL=
DATA_DIR=./data

# ===== Teléfono de contacto =====
# ninguna: el vendedor escribe su WhatsApp al publicar (modo inicial, sin costo).
# otp:     el vendedor confirma el número con un código por WhatsApp/SMS (requiere OTP_PROVIDER=meta o twilio).
TELEFONO_VERIFICACION=ninguna
# Revisar a mano la primera publicación de cada cuenta antes de mostrarla (si | no)
MODERAR_PRIMER_AVISO=si
# Tareas diarias (vencer avisos, alertas, limpieza) dentro del mismo proceso (si | no). "no" si usás cron externo.
CRON_INTERNO=si
# Administrador inicial: si están definidos, al arrancar se crea (o se promueve) ese usuario como admin.
# Alternativa con consola: node scripts/crear-admin.js email contraseña
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Fotos =====
# local: carpeta UPLOAD_DIR (necesita disco persistente: VPS). s3: bucket compatible S3 (Cloudflare R2 gratis 10 GB; obligatorio en Render/Railway/Fly).
STORAGE=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL pública del bucket sin barra final (R2: https://pub-xxxxxxxx.r2.dev o un dominio propio)
S3_PUBLIC_URL=
MAX_FOTOS=20
MAX_FOTO_MB=10

# ===== Redis (opcional; rate limiting compartido entre procesos) =====
# REDIS_URL=redis://localhost:6379

# ===== Verificación de teléfono (OTP), solo si TELEFONO_VERIFICACION=otp =====
# Proveedor: console (imprime el código en consola, solo dev) | meta (WhatsApp Cloud API) | twilio (SMS)
OTP_PROVIDER=console
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TEMPLATE=codigo_verificacion
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ===== Email transaccional (confirmación de cuenta, recuperar contraseña, alertas) =====
# console | smtp   (Brevo tiene 300 emails/día gratis)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AgroMarket <no-responder@tu-dominio.com.ar>"

# ===== Cloudflare Turnstile (CAPTCHA invisible, gratis). Vacío = desactivado =====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ===== Mercado Pago (destacados). Vacío = sin servicios pagos, no se muestran los botones "Destacar" =====
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ===== Reglas de negocio =====
AVISO_DIAS=60
AVISOS_GRATIS_CUENTA_NUEVA=3
OTP_MINUTOS=10
REVEAL_POR_DIA=20
RIESGO_UMBRAL=50

# ===== Precios de destacados (en ARS), solo si MP_ACCESS_TOKEN está cargado =====
PRECIO_DESTACADO_7=8000
PRECIO_DESTACADO_15=14000
PRECIO_DESTACADO_30=24000
PRECIO_BUMP=2000
