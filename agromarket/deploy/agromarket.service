# /etc/systemd/system/agromarket.service
[Unit]
Description=AgroMarket (Node.js)
After=network.target postgresql.service

[Service]
Type=simple
User=agromarket
WorkingDirectory=/opt/agromarket
EnvironmentFile=/opt/agromarket/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/agromarket/uploads /opt/agromarket/data

[Install]
WantedBy=multi-user.target
