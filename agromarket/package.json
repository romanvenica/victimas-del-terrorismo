{
  "name": "agromarket",
  "version": "0.1.0",
  "description": "Marketplace de maquinaria agrícola para Argentina: clasificados con contacto directo y teléfono verificado.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "setup": "npm run migrate && npm run seed",
    "admin:create": "node scripts/crear-admin.js",
    "vencer": "node scripts/vencer-avisos.js",
    "test": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "connect-session-knex": "^5.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "libphonenumber-js": "^1.13.13",
    "marked": "^18.0.13",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  }
}
